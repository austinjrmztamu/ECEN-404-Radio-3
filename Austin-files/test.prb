[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS TRANSIENT_ANALYSIS
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Time
RANGEFLAG AUTO
TYPE LINEAR
UNIT s
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(Vout_6V)
MARKERID 42
END TRACE V(Vout_6V)
BEGIN TRACE V(Vout_5V)
MARKERID 43
END TRACE V(Vout_5V)
BEGIN TRACE V(Vout_3.3V)
MARKERID 44
END TRACE V(Vout_3.3V)
BEGIN TRACE V(U4:VSENSE)
MARKERID 45
END TRACE V(U4:VSENSE)
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST SESSION
